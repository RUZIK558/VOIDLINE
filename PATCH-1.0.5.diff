+import http from 'node:http';
+const sleep=ms=>new Promise(r=>setTimeout(r,ms));
+// Only probe the private listener, never an address supplied by a peer or a proxy.
+export function probeLocalUI(origin,{timeout=1500}={}){
+ const url=new URL('/',origin);
+ if(url.protocol!=='http:'||url.hostname!=='127.0.0.1')return Promise.reject(new Error('UI must use private IPv4 loopback'));
+ return new Promise((resolve,reject)=>{let size=0,body='';const req=http.get(url,{agent:false},res=>{
+  res.setEncoding('utf8');res.on('data',s=>{size+=s.length;if(size>1024*1024){req.destroy(new Error('UI response too large'));return;}body+=s;});
+  res.on('end',()=>res.statusCode===200&&body.includes('id="createOpen"')?resolve({status:200,bytes:size}):reject(new Error('Local UI not ready: HTTP '+res.statusCode)));
+  res.on('error',reject);
+ });req.setTimeout(timeout,()=>req.destroy(new Error('Local UI readiness timeout')));req.on('error',reject);});
+}
+export async function loadLocalUI({origin,load,ready=()=>false,probe=probeLocalUI,log=()=>{},attempts=3,delay=sleep,isClosed=()=>false}){
+ const url=new URL('/',origin).href;let last;
+ for(let i=0;i<attempts;i++){
+  if(isClosed())return {closed:true};
+  try{const status=await probe(origin);log('ui-ready',JSON.stringify(status));await load(url);if(!await ready())throw Error('Loaded document has no game interface');log('ui-loaded',url);return {attempts:i+1,url};}
+  catch(e){last=e;log('ui-load-failed',JSON.stringify({attempt:i+1,code:e.code,errno:e.errno,message:e.message,url}));
+   // ERR_ABORTED can be a superseded navigation while the requested UI has loaded.
+   if(await Promise.resolve().then(ready).catch(()=>false)){log('ui-recovered','Interface already loaded');return {attempts:i+1,url,recovered:true};}
+   if(i+1<attempts)await delay([180,500,1000][i]??1000);
+  }
+ }
+ throw new Error('Не удалось открыть локальный интерфейс после '+attempts+' попыток. '+(last?.message||''),{cause:last});
+}
