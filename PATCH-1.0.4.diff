+ const heavy=carry([0,.26,.48,.72,1],[0,.055,-.045,-.02,0],[0,.035,-.025,-.015,0],[0,.12,-.32,-.16,0],[0,.28,-.22,-.08,0],[0,.12,-.16,-.07,0]);
+ return [{name:'inspect',duration:id==='butterfly'?2.45:1.85,tracks:inspect},{name:'equip',duration:id==='butterfly'?.82:.64,tracks:equip},{name:'fire',duration:.45,tracks:fire},{name:'heavy',duration:.85,tracks:heavy}];
