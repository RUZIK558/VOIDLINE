+import {test} from 'node:test';import assert from 'node:assert/strict';
+import {knifeMotion,easedTrack} from '../public/knife-motion.mjs';
+test('knife clips have finite smooth monotonic time samples and no excessive spin',()=>{for(const id of ['butterfly','karambit'])for(const c of knifeMotion(id)){assert.ok(c.duration>0);assert.equal(new Set(c.tracks.map(t=>t[0])).size,c.tracks.length);for(const[p,t,v]of c.tracks){assert.equal(t.length,v.length);assert.equal(t[0],0);assert.equal(t.at(-1),1);for(let i=0;i<t.length;i++){assert.ok(Number.isFinite(v[i]));if(i)assert.ok(t[i]>t[i-1]);}assert.ok(Math.max(...v)-Math.min(...v)<=Math.PI*2+.001,p);}}});
+test('butterfly only articulates free parts about Y pin axes, safe handle is held',()=>{for(const c of knifeMotion('butterfly')){assert.ok(!c.tracks.some(([p])=>/SafeHandle|BladePivot|Knife\.rotation/.test(p)));for(const[p]of c.tracks.filter(([p])=>/SwingPivot|BiteHandle/.test(p)))assert.ok(p.endsWith('rotation[y]'));}const c=knifeMotion('butterfly')[0];for(const name of ['SwingPivot','BiteHandle']){const v=c.tracks.find(([p])=>p===name+'.rotation[y]')[2];assert.equal(v[0],0);assert.equal(v.at(-1),-Math.PI*2);for(let i=1;i<v.length;i++)assert.ok(v[i]<=v[i-1]+1e-8);}});
+test('karambit makes one directional finger-ring orbit, not centre-of-weapon Z propeller',()=>{const c=knifeMotion('karambit')[0],v=c.tracks.find(([p])=>p==='RingPivot.rotation[y]')[2];assert.equal(v.at(-1),-Math.PI*2);assert.ok(!c.tracks.some(([p])=>/Knife\.rotation|RingPivot.rotation\[[xz]\]/.test(p)));for(let i=1;i<v.length;i++)assert.ok(v[i]<=v[i-1]+1e-8);});
+test('attacks and inspection return the carrying hand to rest',()=>{for(const id of ['butterfly','karambit'])for(const c of knifeMotion(id))for(const[p,t,v]of c.tracks){if(!/Pivot|Handle/.test(p))assert.equal(v.at(-1),0,p);}});
+test('phase easing preserves endpoints with gentle acceleration',()=>{const[p,t,v]=easedTrack('test',[0,1],[0,1]);assert.equal(v[0],0);assert.equal(v.at(-1),1);assert.ok(v[1]<t[1]/10);assert.ok(1-v.at(-2)<(1-t.at(-2))/10);});
