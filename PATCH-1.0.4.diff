+// Local hinge axes follow the authored X/Z blade plane: pin and ring axes are Y.
+// Smooth phase sampling avoids linear-key speed changes and Euler shortest-path reversal.
+export function easedTrack(path,times,values){
+ const ts=[],vs=[];
+ for(let i=0;i<times.length-1;i++){
+  const steps=Math.max(2,Math.ceil((times[i+1]-times[i])*90));
+  for(let n=0;n<steps;n++){const u=n/steps,s=u*u*(3-2*u);ts.push(times[i]+(times[i+1]-times[i])*u);vs.push(values[i]+(values[i+1]-values[i])*s);}
+ }
+ ts.push(times.at(-1));vs.push(values.at(-1));return [path,ts,vs];
+}
+const tr=(path,t,v)=>easedTrack(path,t,v),pi=Math.PI;
+export function knifeMotion(id){
+ if(!['butterfly','karambit'].includes(id))throw new Error('Unsupported articulated knife');
+ const carry=(times,x,y,z,rx,rz)=>[
+  tr('KnifeMotion.position[x]',times,x),tr('KnifeMotion.position[y]',times,y),tr('KnifeMotion.position[z]',times,z),
+  tr('R_Hand.rotation[x]',times,rx),tr('R_Hand.rotation[z]',times,rz)
+ ];
+ const inspect=carry([0,.18,.78,1],[0,-.055,-.055,0],[0,.075,.075,0],[0,-.045,-.045,0],[0,.16,.16,0],[0,-.12,-.12,0]);
+ const equip=carry([0,.42,.8,1],[.035,0,0,0],[-.30,.025,0,0],[.08,0,0,0],[-.6,.16,0,0],[.12,-.08,0,0]);
+ if(id==='butterfly'){
+  const t=[0,.12,.27,.43,.52,.70,.88,1];
+  inspect.push(tr('SwingPivot.rotation[y]',t,[0,0,-.08,-pi,-pi,-2*pi,-2*pi,-2*pi]),tr('BiteHandle.rotation[y]',t,[0,-pi,-pi,-pi,-pi,-pi,-2*pi,-2*pi]));
+  equip.push(tr('SwingPivot.rotation[y]',[0,.18,.62,.8,1],[pi,pi,0,0,0]),tr('BiteHandle.rotation[y]',[0,.18,.62,.9,1],[pi,pi,pi,0,0]));
+ }else{
+  // A single forward orbit about the index ring, not a propeller about the weapon centre.
+  inspect.push(tr('RingPivot.rotation[y]',[0,.2,.30,.69,.80,1],[0,0,-.16,-2*pi,-2*pi,-2*pi]));
+  equip.push(tr('RingPivot.rotation[y]',[0,.12,.70,.87,1],[pi,pi,0,0,0]));
+ }
